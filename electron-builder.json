{
  "appId": "com.pitchpilot.app",
  "productName": "PitchPilot",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/koffi/**/*",
    "**/*.node"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}

