{
  "name": "pitchpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build && npm run build:preload",
    "build:preload": "esbuild electron/preload.cjs --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "electron .",
    "prestart": "npm run build:preload",
    "start": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "npm run test:unit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "npm run typecheck:test && jest --runInBand",
    "test:e2e": "npm run build:preload && playwright test",
    "test:e2e:headless": "npm run build:preload && xvfb-run -a playwright test",
    "test:all": "npm run test:unit && npm run test:e2e:headless",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "papaparse": "^5.7.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
